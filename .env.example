# Neon pooled connection string (use the "-pooler" host for serverless functions)
DATABASE_URL="postgresql://user:password@ep-example-pooler.region.aws.neon.tech/asturlab?sslmode=require"
# Optional: Neon's direct (non-pooler) string, used only for migrations at build time
DIRECT_URL="postgresql://user:password@ep-example.region.aws.neon.tech/asturlab?sslmode=require"

# Stripe, test mode only
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."

# Public origin, no trailing slash
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
